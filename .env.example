# Database Configuration (PostgreSQL + pgvector via Docker)
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fashion_search

# AI API Keys & Models
# OPENAI_API_KEY is used for:
#   1. Intent Extraction (gpt-4o-mini)
#   2. STT Transcription (whisper-1)
#   3. Text Embedding (text-embedding-3-small, 768 dimensions)
# System automatically falls back to local SigLIP / rule-based / mock if empty.
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Embedding & Search Configuration
TEXT_EMBEDDING_MODEL=text-embedding-3-small
THRESHOLD_TEXT=0.45
THRESHOLD_IMAGE=0.65

# Dataset Download (Optional)
KAGGLE_API_TOKEN=your_kaggle_token_here
