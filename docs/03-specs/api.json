            "title": "Color Code"
          },
          "color_name": {
            "type": "string",
            "title": "Color Name"
          },
          "category_group": {
            "type": "string",
            "title": "Category Group"
          },
          "category_sub": {
            "type": "string",
            "title": "Category Sub"
          },
          "detail_desc": {
            "type": "string",
            "title": "Detail Desc"
          },
          "image_path": {
            "type": "string",
            "title": "Image Path"
