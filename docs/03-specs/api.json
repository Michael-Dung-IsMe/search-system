            ],
            "title": "Query Type"
          }
        },
        "type": "object",
        "title": "Body_search_products_api_search_post"
      },
      "Body_transcribe_audio_api_transcribe_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_transcribe_audio_api_transcribe_post"
      },
      "ConstraintChip": {
        "properties": {
          "chip_id": {
            "type": "string",
            "title": "Chip Id",
            "description": "Unique identifier for the chip, e.g. 'color:10' or 'price:1000000'"
          },
          "label": {
            "type": "string",
            "title": "Label",
            "description": "Human-readable label, e.g. 'Màu: Trắng' or 'Tối đa: 1.000.000đ'"
          },
          "chip_type": {
            "type": "string",
            "enum": [
              "category",
              "gender",
              "color",
              "price",
              "material",
              "exclude_color",
              "exclude_material",
              "reference"
            ],
            "title": "Chip Type"
          },
          "value": {
            "title": "Value",
            "description": "Underlying value represented by the chip"
          },
          "is_removable": {
            "type": "boolean",
            "title": "Is Removable",
            "description": "Whether the user can click [x] to remove this chip",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "chip_id",
          "label",
          "chip_type",
          "value"
        ],
        "title": "ConstraintChip",
        "description": "Represents an active interactive filter chip shown in the UI."
      },
      "DetectResponse": {
        "properties": {
          "image_hash": {
            "type": "string",
            "title": "Image Hash"
          },
          "total_boxes": {
            "type": "integer",
            "title": "Total Boxes"
          },
          "boxes": {
            "items": {
              "$ref": "#/components/schemas/DetectedBox"
            },
            "type": "array",
            "title": "Boxes"
          }
        },
        "type": "object",
        "required": [
          "image_hash",
          "total_boxes",
          "boxes"
        ],
        "title": "DetectResponse",
        "description": "Response returned by /api/detect."
      },
      "DetectedBox": {
        "properties": {
          "box_id": {
            "type": "string",
            "title": "Box Id",
            "description": "Unique box ID"
          },
          "label": {
            "type": "string",
            "title": "Label",
            "description": "Canonical garment label (e.g., Top, Pants, Shoes, Bag, Dress)"
          },
          "score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Score",
            "description": "Detection confidence score"
          },
          "box_2d": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 4,
            "title": "Box 2D",
            "description": "[ymin, xmin, ymax, xmax] normalized to [0.0, 1.0]"
          },
          "polygon": {
            "anyOf": [
              {
                "items": {
                  "items": {
                    "type": "number"
                  },
                  "type": "array"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Polygon",
            "description": "Normalized [x, y] polygon vertices tracing garment contour for SVG glow highlighting"
          }
        },
        "type": "object",
        "required": [
          "box_id",
          "label",
          "score",
          "box_2d"
        ],
        "title": "DetectedBox",
        "description": "Normalized bounding box detected by OWL-ViT."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
