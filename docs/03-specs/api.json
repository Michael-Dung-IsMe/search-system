          "color_name",
          "category_group",
          "category_sub",
          "detail_desc",
          "image_path"
        ],
        "title": "ProductDetailResponse",
        "description": "Detailed product information returned by /api/products/{id}."
      },
      "SearchResponse": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "turn_index": {
            "type": "integer",
            "title": "Turn Index"
          },
          "total_results": {
            "type": "integer",
            "title": "Total Results"
          },
          "search_state": {
            "$ref": "#/components/schemas/SearchState"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/SearchResultItem"
            },
            "type": "array",
            "title": "Items"
          },
          "latency_ms": {
            "type": "integer",
            "title": "Latency Ms",
            "default": 0
          },
          "query_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Query Id"
          },
          "has_exact_match": {
            "type": "boolean",
            "title": "Has Exact Match",
            "default": true
          },
          "exact_items": {
            "items": {
              "$ref": "#/components/schemas/SearchResultItem"
